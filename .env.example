# Provider keys: set at least one. Use two different providers so the verifier
# and judge models are independent of the generator.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model roles (LiteLLM model strings). Change freely; nothing else depends on them.
GENERATOR_MODEL=gemini/gemini-2.5-flash
VERIFIER_MODEL=groq/llama-3.3-70b-versatile
JUDGE_MODEL=groq/llama-3.3-70b-versatile
VLM_MODEL=gemini/gemini-2.5-flash
STT_MODEL=groq/whisper-large-v3

# Local models (added in later steps)
EMBED_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Grounding and limits
REFUSAL_THRESHOLD=0.35
MAX_UPLOAD_MB=50
MAX_VIDEO_MINUTES=20
CALLS_PER_SESSION_PER_HOUR=120